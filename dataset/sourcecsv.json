		"schema": [
			{
				"name": "ID",
				"type": "String"
			},
			{
				"name": "Name",
				"type": "String"
			},
			{
				"name": "Gender",
				"type": "String"
			},
			{
				"name": "Age",
				"type": "String"
			},
			{
				"name": "Email",
				"type": "String"
			},
			{
				"name": "Address",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}