			"referenceName": "linktotestblobstorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
